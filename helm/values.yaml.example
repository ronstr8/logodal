# Global settings shared across all microservices
global:
  domain: your-domain.example.com
  # Brands ("skins") served by this one deployment, sharing one database and
  # one player pool. Each site gets its own ingress host + TLS secret; the
  # frontend and backend pick the brand from the request's Host header.
  # Omit `brands` entirely to serve a single site from ingress.host.
  brands:
    default: logodal
    sites:
      - host: logodal.example.com
        brand: logodal
        tlsSecret: logodal-tls
      - host: wordwank.example.com
        brand: wordwank
        tlsSecret: wordwank-tls
  # The single port for all traffic (Frontend, API, WS)
  externalPort: 80
  registry: localhost:5000
  namespace: logodal
  projectName: "logodal"
  imageTag: latest
  imagePullPolicy: Always
  maxPlayers: 13
  randomLetterScoreMode: "true"
  gameDuration: 30
  quickBonusSeconds: 10
  # Skip the Discord/SMS "started playing" alert if a human joined within this many seconds.
  adminNotifyQuietSeconds: 300
  rackSize: 7
  # Length bonus: lengthBonusBase points at lengthBonusStart letters, doubling per letter after.
  lengthBonusStart: 5
  lengthBonusBase: 10
  minVowels: 2
  minConsonants: 2
  logLevel: info
  defaultLanguage: en
  chatHistorySize: 50
  totalTiles: 100
  kofiId: "your-kofi-id"
  kofiEnabled: false
  paypalEnabled: false
  paypalEmail: "your-email@example.com"
  projectCodeLink: "https://github.com/your-org/logodal"
  scoreAgainstAI: "true"
  endOnAllPlayed: "false"
  redisUrl: "redis://redis-master:6379"
  storageClass: "standard"
  persistence:
    manualPV: false


# Centralized Ingress configuration
ingress:
  enabled: true
  host: your-domain.example.com
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
  tls:
    enabled: false
    secretName: logodal-tls

# Subchart overrides
frontend:
  enabled: true
  service:
    type: ClusterIP
    port: 80

wordd:
  enabled: true
  service:
    type: ClusterIP
    port: 2345
  langs: "en,es,fr,de,ru"

backend:
  enabled: true
  service:
    port: 3000
  ollama:
    url: "http://ollama.<namespace>.svc.cluster.local:11434"
    model: "gemma3:12b"    # strong multilingual voice, non-reasoning (low TTFT). ~1.1s/line on a 16GB card.
                           # Lighter: llama3.1:8b (~0.5s). Avoid reasoning models (qwen3) unless thinking is disabled.
    chat_context_depth: 5   # recent messages (human + AI + game events) fed into AI prompt; 0 = off
    num_ctx: 4096           # per-request context. Our prompts peak ~400 tokens, but the shared ollama pod sets
                            # OLLAMA_CONTEXT_LENGTH=65536 — inheriting that wastes GBs of f16 KV cache on a 12B.
    idle_chatter: false     # canned/filler AI chatter; off = LLM-only, AIs stay silent when the LLM is unavailable
  ai:
    social_enabled: true        # background greetings / compliments / winner congrats
    social_min_gap: 6           # min seconds between AI social lines in a game
    social_max_per_game: 5      # cap on AI social lines per game
    compliment_min_score: 20    # only compliment human plays scoring at least this
    compliment_chance: 0.5      # probability of complimenting a qualifying play
  database:
    url: "dbi:Pg:dbname=logodal;host=postgresql"
    user: "logodal_backend"
  env:
    ADMIN_SMS_EMAIL: ""
    CHAT_HISTORY_SIZE: 50

# PostgreSQL dependency configuration
postgresql:
  enabled: true
  fullnameOverride: postgresql
  image:
    registry: "docker.io"
    repository: "bitnamilegacy/postgresql"
    tag: "16.4.0-debian-12-r0"
  auth:
    database: "logodal"
    username: "logodal_backend"
  primary:
    initdb:
      scriptsConfigMap: db-init
    persistence:
      enabled: true
      size: 10Gi
  volumePermissions:
    enabled: true
    image:
      repository: busybox
      tag: 1.36.1

redis:
  enabled: true
  fullnameOverride: redis
  architecture: standalone
  auth:
    enabled: false
  master:
    persistence:
      enabled: false
  replica:
    replicaCount: 0

auth:
  sessionSecret: "change-me-to-a-long-random-secret"
  google:
    clientId: ""
    clientSecret: ""
  discord:
    clientId: ""
    clientSecret: ""
  notifications:
    discordWebhook: ""

